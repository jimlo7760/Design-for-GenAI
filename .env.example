NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (no NEXT_PUBLIC_ prefix!). Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model to try first (default gemini-3.8-flash). If it is overloaded or
# unavailable the app falls back to gemini-3.5-flash-lite, then gemini-3.1-flash-lite.
# GEMINI_MODEL=
# Optional: image model for "Render this build" (default gemini-nano-banana-2.1, ~$0.034 per image).
# Needs billing enabled on the Google project; the free tier has no image quota.
# GEMINI_IMAGE_MODEL=
